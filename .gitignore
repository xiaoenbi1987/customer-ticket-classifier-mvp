# === frontend (Next.js) ===
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/*.tsbuildinfo
frontend/next-env.d.ts
frontend/.env*
!frontend/.env*.example

# === backend (FastAPI) ===
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
backend/*.log
backend/data/*.sqlite3
backend/.env
!backend/.env.example

# === misc ===
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*

# claude code local settings (machine-specific)
.claude/settings.local.json

# local office docs / temp files (not part of the codebase)
*.docx
~$*
~WRL*.tmp
