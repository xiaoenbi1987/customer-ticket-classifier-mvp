# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 但模板文件要进版本库：别人 clone 下来得知道有哪些变量要配。
# 子目录 .gitignore 优先级高于根目录，所以这条例外必须写在这里，
# 写在根 .gitignore 里是不生效的。
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
